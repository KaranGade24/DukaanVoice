NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/dukaanvoice
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
JWT_ISSUER=dukaanvoice-api
JWT_AUDIENCE=dukaanvoice-mobile
CORS_ORIGIN=*
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_COOLDOWN_MS=60000
GEMINI_MAX_COOLDOWN_MS=900000
AI_MAX_TOOL_ROUNDS=4
AI_RECURSION_LIMIT=18
AI_HISTORY_LIMIT=8
# Add one or more server-only keys. Never copy these into the mobile app.
GOOGLE_API_KEY_1=
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY=
